<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  NOTE FOR OTHER USERS: every absolute path below is hardcoded for the
  author's machine (user "davidnguyen"). launchd does NOT expand ~, $HOME,
  or env vars in this file, so before `make install` (or copying to
  ~/Library/LaunchAgents) you MUST replace ALL of these for your own setup:
    - ProgramArguments  -> path to your briefing.sh
    - StandardOutPath / StandardErrorPath -> your logs/ dir
    - EnvironmentVariables > HOME -> your home directory
    - EnvironmentVariables > PATH -> dirs holding claude/codex/gemini/copilot
                                     (check with: which claude codex gemini copilot)
  The PATH must contain the CLI engine binaries; under launchd the default
  PATH is just /usr/bin:/bin, so the node/nvm and ~/.local/bin dirs are
  listed explicitly or the engines won't be found.
-->
<dict>
    <key>Label</key>
    <string>com.ainews.briefing</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/davidnguyen/ai-news-briefing/briefing.sh</string>
        <string>--catchup</string>
    </array>

    <!-- Punctual 8am run when the machine is awake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Catch-up: launchd fires a missed interval on the next wake. With
         --catchup the script runs today only if not already done and it's
         past 08:00, so a sleep-through-8am gets covered on wake the same day,
         while a day the machine never opened is simply skipped. -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <key>StandardOutPath</key>
    <string>/Users/davidnguyen/ai-news-briefing/logs/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/davidnguyen/ai-news-briefing/logs/launchd-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/davidnguyen/.local/bin:/Users/davidnguyen/.nvm/versions/node/v22.21.1/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/davidnguyen</string>
        <key>AI_BRIEFING_MODEL</key>
        <string>claude-sonnet-4-6</string>
    </dict>
</dict>
</plist>
